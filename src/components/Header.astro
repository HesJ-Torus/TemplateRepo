---
// Header switcher: picks a design using theme.json → layouts.header.
// Valid names: "classic" (default), "basic", "blurred".
// Unknown or missing names fall back to "classic".
//
// Fixed headers (basic, blurred) must sit outside #smooth-wrapper, otherwise
// ScrollSmoother would scroll them away with the page. So pages render this twice:
//   <Header slot="header" placement="fixed" />   → goes before #smooth-wrapper (see Base.astro)
//   <Header />                                    → goes inside the page as normal
// Each copy only outputs what belongs in its spot:
//   - a normal header (classic) renders in the page;
//   - a fixed header renders in the "header" slot, and leaves an empty spacer in the
//     page so the first section isn't hidden underneath it.
import theme from '../config/theme.json';
import Classic from './headers/Classic.astro';
import Basic from './headers/Basic.astro';
import Blurred from './headers/Blurred.astro';

const variants = {
  classic: { component: Classic, fixed: false },
  basic: { component: Basic, fixed: true, space: '5rem' },
  blurred: { component: Blurred, fixed: true, space: '5.5rem' },
};

const chosen = variants[theme.layouts?.header] ?? variants.classic;
const Variant = chosen.component;
const { placement = 'inline' } = Astro.props;
---
{placement === 'fixed' && chosen.fixed && <Variant />}
{placement === 'inline' && !chosen.fixed && <Variant />}
{placement === 'inline' && chosen.fixed && <div class="header-space" style={`height:${chosen.space}`} aria-hidden="true"></div>}
