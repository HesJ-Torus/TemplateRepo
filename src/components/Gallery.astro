---
// Gallery switcher: picks a design using theme.json → layouts.gallery.
// Valid names: "grid" (default), "2x".
// Unknown or missing names fall back to "grid".
// To add a design: create src/components/galleries/<Name>.astro, import it below,
// add it to `variants`, and add its name to the list above.
import theme from '../config/theme.json';
import Grid from './galleries/Grid.astro';
import TwoUp from './galleries/TwoUp.astro';

const variants = {
  grid: Grid,
  '2x': TwoUp,
};

const Variant = variants[theme.layouts?.gallery] ?? variants.grid;
---
<Variant />
