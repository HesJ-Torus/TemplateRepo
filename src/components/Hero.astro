---
// Hero switcher: picks a design using theme.json → layouts.hero.
// Valid names: "classic" (default).
// Unknown or missing names fall back to "classic".
// To add a design: create src/components/hero/<Name>.astro, import it below,
// add it to `variants`, and add its name to the list above.
import theme from '../config/theme.json';
import Classic from './hero/Classic.astro';
import Wide from './hero/Wide.astro';

const variants = {
  classic: Classic,
  wide: Wide,
};

const Variant = variants[theme.layouts?.hero] ?? variants.classic;
---
<Variant />
