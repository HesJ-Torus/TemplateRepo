// Cloudflare deploy settings. "name" becomes the project name in Cloudflare,
// so it must be different for each client (npm run new-client sets it).
{
  "name": "corve-dale-joinery",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
